<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Launchd manifest TEMPLATE for com.rahat.weekly-report (2026-10-04):
    the weekly platform report: spend and search queries against the free allowance, golden-set pass rate, judge agreement, owner correction rate, knowledge-base coverage (ADR-018 §2.9–2.10).

    Render and load by hand (the owner only; see private/prds/platform/RUNBOOK_2026-10-04.md):
        sed -e "s|{{RAHAT_HOME}}|$HOME/developer/agency/rahat|g" \
            -e "s|{{PYTHON_BIN}}|$HOME/developer/agency/rahat/.venv/bin/python|g" \
            scripts/com.rahat.weekly-report.plist.template > ~/Library/LaunchAgents/com.rahat.weekly-report.plist
        launchctl load -w ~/Library/LaunchAgents/com.rahat.weekly-report.plist

    Secrets live in .env (the script loads dotenv itself). NEVER put a
    literal $VAR here: launchd does not shell-expand (the 2026-08-01
    literal-$HOME incident).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rahat.weekly-report</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON_BIN}}</string>
        <string>-u</string>
        <string>scripts/weekly_report.py</string>
        <string>--send</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{RAHAT_HOME}}</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>0</integer>
            <key>Hour</key>
            <integer>18</integer>
            <key>Minute</key>
            <integer>5</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>{{RAHAT_HOME}}/vault/weekly_report.log</string>
    <key>StandardErrorPath</key>
    <string>{{RAHAT_HOME}}/vault/weekly_report.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
